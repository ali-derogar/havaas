# Generate independent random hex values; never use these placeholder strings.
POSTGRES_PASSWORD=replace-with-random-hex
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_PORT=4173
APP_BIND=127.0.0.1
APP_ORIGIN=http://localhost:4173
# For local Node development against an explicitly published development DB:
DATABASE_URL=postgresql://havaas:replace-with-random-hex@127.0.0.1:55432/havaas
# Production override: DOMAIN=example.org
